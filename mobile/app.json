      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20"
      },
      "package": "com.gustavo_soares_dev.agrotechmobile"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
